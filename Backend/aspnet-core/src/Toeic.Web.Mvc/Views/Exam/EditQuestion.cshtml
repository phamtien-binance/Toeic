@using Toeic.Web.Models.Exam
@model EditQuestionViewModel
@{
    Layout = "~/Views/Shared/_ExamLayout.cshtml";
    var keys = new[] { "A", "B", "C", "D" };
}
@section TopActions {
    <a class="btn btn-sm" asp-action="Preview" asp-route-id="@Model.ExamId">← Về đề thi</a>
}

<div class="split">
    <form method="post" asp-action="EditQuestion" asp-route-id="@Model.ExamId" asp-route-questionId="@Model.QuestionId">
        <div class="card">
            <div class="card-head">
                <div class="card-title">Câu @Model.Number · Part @Model.Part</div>
                <span class="badge badge-grey" style="margin-left:auto">@Model.ExamTitle</span>
            </div>
            <div class="card-body" style="display:flex;flex-direction:column;gap:16px">
                <div class="field">
                    <label>Nội dung câu hỏi (dùng ------- cho chỗ trống)</label>
                    <textarea name="stem" rows="4" class="input" style="height:auto;padding:10px 12px;line-height:1.6">@Model.Stem</textarea>
                </div>

                <div style="display:flex;flex-direction:column;gap:10px">
                    <label style="font-size:12px;font-weight:650;color:var(--ink-2)">Bốn phương án — chọn nút radio ở đáp án đúng</label>
                    @foreach (var o in Model.Options.OrderBy(x => x.OrderIndex))
                    {
                        <div class="opt" style="align-items:center;gap:12px">
                            <input type="radio" name="answerKey" value="@o.Key" @(o.Key == Model.AnswerKey ? "checked" : "") style="width:16px;height:16px" />
                            <span class="k">@o.Key</span>
                            <input type="text" name="opt@(o.Key)" value="@o.Text" class="input" style="height:38px" />
                        </div>
                    }
                </div>

                <div class="field">
                    <label>Gợi ý / giải thích cho sinh viên</label>
                    <textarea name="hint" rows="3" class="input" style="height:auto;padding:10px 12px;line-height:1.6">@Model.Hint</textarea>
                </div>

                <div style="display:flex;gap:10px">
                    <button class="btn btn-primary" type="submit">Lưu thay đổi</button>
                    <a class="btn" asp-action="Preview" asp-route-id="@Model.ExamId">Hủy</a>
                </div>
            </div>
        </div>
    </form>

    <div style="display:flex;flex-direction:column;gap:14px;position:sticky;top:82px">
        <div class="card">
            <div class="card-head"><div class="card-title">Kiểm tra hợp lệ</div></div>
            <div class="card-body" style="font-size:12.5px;line-height:1.9;color:var(--ink-2)">
                <div>✔ Đủ 4 phương án, không để trống</div>
                <div>✔ Đúng 1 đáp án (radio)</div>
                <div>✔ Gợi ý không được rỗng</div>
                <div style="color:var(--muted);margin-top:8px">Nếu vi phạm, hệ thống không lưu và hiện thông báo.</div>
            </div>
        </div>
        <div class="card">
            <div class="card-head"><div class="card-title">Giá trị trước khi sửa</div></div>
            <div class="card-body" style="font-size:12px;color:var(--muted);line-height:1.7">
                <div><b>Đáp án:</b> @Model.PreviousAnswerKey</div>
                <div style="margin-top:6px"><b>Câu hỏi:</b> @Model.PreviousStem</div>
                <div style="margin-top:6px"><b>Gợi ý:</b> @Model.PreviousHint</div>
            </div>
        </div>
        <div class="alert alert-info">Sửa xong bấm <b>Lưu thay đổi</b>. Đề đã xuất bản vẫn sửa được; sinh viên đang thi sẽ nhận nội dung mới ở lần tải đề kế tiếp.</div>
    </div>
</div>
